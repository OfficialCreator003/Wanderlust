<% layout("layouts/boilerplate") %>

<!-- Added a row and column constraint to center the form and prevent it from stretching too wide -->
<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3>Create a New Listing</h3>

        <form method="POST" action="/listings" novalidate class="needs-validation"  enctype="multipart/form-data">
            <div class="mb-3">                                                                                                                                                                                                                                                      
                <label for="title" class="form-label">Title</label>
                <!-- Added id="title" to link with the label, and 'required' -->
                <input id="title" name="listing[title]" placeholder="Enter title" type="text" class="form-control" required /> 
            <div class="valid-feedback">Titile like Good</div>
            
            </div>
            
            <div class="mb-3">  
                <label for="description" class="form-label">Description</label>
                <textarea id="description" name="listing[description]" class="form-control" placeholder="Enter description" required></textarea>
                  <div class="invalid-feedback">description shouls be valid</div>
            </div>

           


<div class="mb-3">
                <label for="image" class="form-label">Uploads Listing images</label>
                <!-- Image might be optional, so left 'required' off -->
                <input id="image" name="listing[image]" type="file" class="form-control" /> 
            required
            </div>



            <!-- Put Price and Country side-by-side to save vertical space -->
            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price</label>
                    <input id="price" name="listing[price]" placeholder="Enter price" type="number" class="form-control" required />
                     <div class="invalid-feedback">price shouls be valid</div> 
                </div>

                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input id="country" name="listing[country]" placeholder="Enter country" type="text" class="form-control" required /> 
                    <div class="invalid-feedback">country shouls be valid</div>
                </div>
            </div>

            <div class="mb-3"> 
                <label for="location" class="form-label">Location</label>  
                <input id="location" name="listing[location]" placeholder="Enter location" type="text" class="form-control" required /> 
            <div class="invalid-feedback">Location shouls be valid</div>
            </div>

            <!-- Added margin-top (mt-3) to separate the button slightly -->
            <button class="btn btn-dark add-btn mt-3">ADD</button>
        </form>
    </div>
</div>

